spring:
  application:
    name: moyelog_BE
    
  output:
    ansi:
      enabled: ALWAYS
  
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB
  
  datasource:
    url: jdbc:mysql://localhost:3306/moyeolog?serverTimezone=Asia/Seoul&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_password_here
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
        highlight_sql: true

logging:
  pattern:
    console: "%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"
  level:
    root: INFO
    org.hibernate.SQL: DEBUG

jwt:
  secret: your_jwt_secret_here # Base64 로 인코딩된 HMAC 키 (환경변수 JWT_SECRET)
  expiration: 86400000 # 액세스 토큰 유효기간(ms), 24 hours (JWT_EXPIRATION)
  refresh-expiration: 604800000 # 리프레시 토큰 유효기간(ms), 7 days (JWT_REFRESH_EXPIRATION)
  # 토큰 종류 클레임(typ) 도입 이전에 발급된 토큰을 받아들일지 여부.
  # 배포 후 리프레시 토큰 유효기간(7일)이 지나면 false 로 바꿔도 됩니다. (JWT_ACCEPT_LEGACY_TOKENS)
  accept-legacy-tokens: true

# 프론트엔드 서버(NextAuth)와 공유하는 비밀값. POST /api/auth/sync 의 X-Internal-Secret 헤더와 비교합니다.
# 비어 있으면 /api/auth/sync 는 항상 401 입니다. (환경변수 INTERNAL_API_SECRET)
internal:
  api-secret: ${INTERNAL_API_SECRET:}

file:
  upload-dir: uploads # 업로드 이미지 저장 경로 (FILE_UPLOAD_DIR). 컨테이너에서는 /app/uploads

cors:
  allowed-origins: https://moyeolog.ruraeru.xyz # 쉼표로 여러 개 지정 가능 (CORS_ALLOWED_ORIGINS)

gemini:
  api:
    key: ${GEMINI_API_KEY:your_gemini_api_key_here}

server:
  tomcat:
    max-http-post-size: 10MB
